# Django REST Framework API root. Do not add a trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional development-server overrides. Without these, Vite uses localhost:5173.
# VITE_DEV_HOST=localhost
# VITE_DEV_PORT=5173

# The live Django API is used by default. Set true only for offline UI work.
#VITE_USE_MOCK_API=false
VITE_USE_MOCK_API=true

# Optional Company mock scenario for deterministic UI-state testing:
# default | empty | list_error | detail_error | create_error | update_error | delete_error
# VITE_COMPANY_MOCK_SCENARIO=default
